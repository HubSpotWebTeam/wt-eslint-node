{
  // Every scenario needs one tag from each list. Inherited tags count (Feature, Rule,
  // Examples). Other tags are ignored. ignoreUntagged must stay false or fully untagged
  // scenarios are skipped.
  "required-tags": ["error", {
    "ignoreUntagged": false,
    "global": [
      ["@qa", "@prod"],
      ["@en", "@es", "@fr", "@de", "@jp", "@br"]
    ]
  }],

  "no-duplicate-tags": "error",
  // allowSeparated:false so "@qa @en #@smoke" fails. The default true allows it.
  "no-partially-commented-tag-lines": ["error", { "allowSeparated": false }],

  "no-empty-file": "error",
  "no-files-without-scenarios": "error",
  "no-unnamed-features": "error",
  "no-unnamed-scenarios": "error",
  "no-scenario-outlines-without-examples": "error",
  "no-empty-background": "error",
  "no-background-only-scenario": "error",
  "no-dupe-feature-names": "error",
  // in-feature, not the default "anywhere", which flags the same name in unrelated features.
  "no-dupe-scenario-names": ["error", "in-feature"],
  "use-and": "error",
  "name-length": ["error", { "Feature": 60, "Scenario": 120, "Step": 475 }]

  // Whitespace rules (indentation, no-trailing-spaces, new-line-at-eof,
  // no-multiple-empty-lines) left off: prettier owns those.
}
